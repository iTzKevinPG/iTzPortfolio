---
/** Visor de capturas con <dialog> nativo (foco, Esc y fondo inerte los da el navegador). */
import Icon from '@/components/ui/Icon.astro';
---

<dialog class="lb" data-lb aria-label="Imagen ampliada">
	<button type="button" class="lb__close" data-lb-close aria-label="Cerrar">
		<Icon name="close" />
	</button>
	<img class="lb__img" data-lb-img alt="" />
</dialog>

<script>
	const dialog = document.querySelector<HTMLDialogElement>('[data-lb]');
	const img = dialog?.querySelector<HTMLImageElement>('[data-lb-img]');

	/** La fuente más grande del <picture> (prefiere WebP: decodifica más rápido que AVIF a ese tamaño). */
	function largest(picture: Element): string | null {
		const source = picture.querySelector('source[type="image/webp"]') ?? picture.querySelector('source');
		const set = source?.getAttribute('srcset') ?? picture.querySelector('img')?.getAttribute('srcset');
		if (!set) return picture.querySelector('img')?.currentSrc ?? null;
		return (
			set
				.split(',')
				.map((s) => s.trim().split(/\s+/)[0])
				.at(-1) ?? null
		);
	}

	document.addEventListener('click', (e) => {
		const btn = (e.target as HTMLElement).closest('[data-lightbox]');
		if (!btn || !dialog || !img) return;
		const fig = btn.closest('[data-shot]');
		const pic = fig?.querySelector('picture');
		const src = pic ? largest(pic) : null;
		if (!src) return;
		img.src = src;
		img.alt = pic?.querySelector('img')?.alt ?? '';
		dialog.showModal();
		window.__lenis?.stop();
	});

	dialog?.addEventListener('close', () => window.__lenis?.start());
	dialog?.addEventListener('click', (e) => {
		if (e.target === dialog || (e.target as HTMLElement).closest('[data-lb-close]')) dialog.close();
	});
</script>

<style>
	.lb {
		max-width: none;
		max-height: none;
		width: 100%;
		height: 100%;
		padding: clamp(1rem, 4vw, 3rem);
		border: 0;
		background: transparent;
		display: grid;
		place-items: center;
		opacity: 0;
		transition:
			opacity var(--dur) ease,
			display var(--dur) allow-discrete,
			overlay var(--dur) allow-discrete;
	}

	.lb:not([open]) {
		display: none;
	}

	.lb[open] {
		opacity: 1;
	}

	@starting-style {
		.lb[open] {
			opacity: 0;
		}
	}

	.lb::backdrop {
		background: color-mix(in srgb, var(--ink) 88%, transparent);
		backdrop-filter: blur(6px);
	}

	.lb__img {
		max-width: 100%;
		max-height: 100%;
		width: auto;
		border-radius: var(--radius);
		border: 1px solid var(--line-strong);
		cursor: zoom-out;
		transition: scale var(--dur) var(--ease-out);
	}

	@starting-style {
		.lb[open] .lb__img {
			scale: 0.96;
		}
	}

	.lb__close {
		position: fixed;
		top: var(--space-4);
		right: var(--space-4);
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 50%;
		border: 1px solid var(--line-strong);
		background: var(--surface);
		cursor: pointer;
	}

	.lb__close :global(svg) {
		width: 1.1rem;
		height: 1.1rem;
	}
</style>
