---
/**
 * Navegación de secciones. Escritorio: riel lateral cuya línea se pinta con el avance.
 * Móvil: barra superior con el nombre de la sección y el progreso.
 * Estado (--trail, sección activa) lo calcula scripts/nav.ts.
 */
import { nav } from '@/data/site';
---

<nav class="snav" aria-label="Secciones" data-nav>
	<span class="snav__rail" aria-hidden="true">
		<span class="snav__fill"></span>
	</span>
	<ul>
		{nav.map((s) => (
			<li>
				<a href={`#${s.id}`} class="snav__link" data-nav-link={s.id}>
					<span class="snav__label">{s.label}</span>
					<span class="snav__dot" aria-hidden="true" />
				</a>
			</li>
		))}
	</ul>
</nav>

<div class="mbar" aria-hidden="true" data-nav>
	<span class="mbar__label" data-nav-label>
		{nav[0].label}
	</span>
	<span class="mbar__track">
		<span class="mbar__fill"></span>
	</span>
</div>

<style>
	/* ---- Riel lateral ---- */
	.snav {
		--step: 2.25rem;
		position: fixed;
		right: clamp(0.75rem, 2vw, 2rem);
		top: 50%;
		translate: 0 -50%;
		z-index: var(--z-nav);
	}

	.snav ul {
		list-style: none;
		padding: 0;
		display: grid;
	}

	.snav__rail {
		position: absolute;
		right: calc(0.75rem / 2 - 1px);
		top: calc(var(--step) / 2);
		bottom: calc(var(--step) / 2);
		width: 2px;
		background: var(--border);
		border-radius: 2px;
		overflow: clip;
	}

	.snav__fill {
		position: absolute;
		inset: 0;
		background: var(--accent);
		transform-origin: top;
		transform: scaleY(var(--trail, 0));
	}

	.snav__link {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: var(--space-3);
		height: var(--step);
	}

	.snav__label {
		font-size: var(--text-xs);
		font-family: var(--font-mono);
		color: var(--text-muted);
		opacity: 0;
		translate: 6px 0;
		transition:
			opacity var(--dur) ease,
			translate var(--dur) var(--ease-out),
			color var(--dur) ease;
	}

	.snav__dot {
		position: relative;
		width: 0.75rem;
		height: 0.75rem;
		border-radius: 50%;
		background: var(--ink);
		border: 2px solid var(--line-strong);
		transition:
			border-color var(--dur) ease,
			background-color var(--dur) ease,
			scale var(--dur) var(--ease-out);
	}

	.snav__link.is-lit .snav__dot {
		border-color: var(--accent);
	}

	.snav__link.is-active .snav__dot {
		background: var(--accent);
		scale: 1.3;
		box-shadow: 0 0 12px var(--accent);
	}

	.snav__link.is-active .snav__label,
	.snav:hover .snav__label,
	.snav:focus-within .snav__label {
		opacity: 1;
		translate: 0 0;
	}

	.snav__link.is-active .snav__label {
		color: var(--text);
	}

	.snav__link:hover .snav__label {
		color: var(--accent-text);
	}

	/* ---- Barra móvil ---- */
	.mbar {
		display: none;
	}

	@media (width < 1100px) {
		.snav {
			display: none;
		}

		.mbar {
			display: grid;
			gap: 0.4rem;
			position: fixed;
			inset: 0 0 auto;
			z-index: var(--z-progress);
			padding: 0.6rem var(--gutter) 0.55rem;
			background: color-mix(in srgb, var(--bg) 78%, transparent);
			backdrop-filter: blur(10px);
			border-bottom: 1px solid var(--border);
			translate: 0 -100%;
			transition: translate var(--dur) var(--ease-out);
		}

		.mbar.is-shown {
			translate: 0 0;
		}

		.mbar__label {
			font-family: var(--font-mono);
			font-size: var(--text-xs);
			text-transform: uppercase;
			letter-spacing: 0.12em;
			color: var(--accent-text);
		}

		.mbar__track {
			position: relative;
			height: 2px;
			background: var(--border);
			border-radius: 2px;
			overflow: clip;
		}

		.mbar__fill {
			position: absolute;
			inset: 0;
			background: linear-gradient(to right, var(--violet), var(--live));
			transform-origin: left;
			transform: scaleX(var(--trail, 0));
		}
	}
</style>
