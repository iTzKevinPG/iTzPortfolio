---
/** Ícono por referencia al sprite (<symbol id="i-…"> en Sprite.astro): el path viaja una sola vez. */
import { iconPath } from '@/lib/icons';

type Props = { name: string; class?: string; label?: string };
const { name, class: className, label } = Astro.props;
if (!iconPath(name)) throw new Error(`Ícono desconocido: ${name}`);
---

<svg
	class={className}
	viewBox="0 0 24 24"
	fill="currentColor"
	role={label ? 'img' : undefined}
	aria-label={label}
	aria-hidden={label ? undefined : 'true'}
	focusable="false"
>
	<use href={`#i-${name}`}></use>
</svg>
