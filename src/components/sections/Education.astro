---
import SectionHead from '@/components/ui/SectionHead.astro';
import { education } from '@/data/site';
---

<section id="educacion" class="section" aria-labelledby="edu-title">
	<div class="wrap edu">
		<div>
			<SectionHead id="edu-title" title={education.title} />
			<ol class="edu__list">
				{education.items.map((item) => (
					<li class="edu__item" data-reveal>
						<span class="edu__period">{item.period}</span>
						<div>
							<p class="edu__degree">{item.degree}</p>
							<p class="edu__inst">
								{item.institution} <span aria-hidden="true">·</span> {item.place}
							</p>
						</div>
					</li>
				))}
			</ol>
		</div>

		<dl class="edu__extra" data-reveal>
			<div>
				<dt>Idiomas</dt>
				{education.languages.map((l) => (
					<dd>{l}</dd>
				))}
			</div>
			<div>
				<dt>Intereses</dt>
				{education.interests.map((l) => (
					<dd>{l}</dd>
				))}
			</div>
		</dl>
	</div>
</section>

<style>
	.edu {
		display: grid;
		grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
		gap: var(--space-16);
		align-items: end;
	}

	.edu__list {
		list-style: none;
		padding: 0;
		border-top: 1px solid var(--border);
	}

	.edu__item {
		display: grid;
		grid-template-columns: 9rem minmax(0, 1fr);
		gap: var(--space-6);
		padding-block: var(--space-6);
		border-bottom: 1px solid var(--border);
	}

	.edu__period {
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		color: var(--accent-text);
		padding-top: 0.2em;
	}

	.edu__degree {
		font-family: var(--font-display);
		font-size: var(--text-lg);
		font-weight: 600;
		line-height: 1.3;
	}

	.edu__inst {
		color: var(--text-muted);
		font-size: var(--text-sm);
		margin-top: var(--space-1);
	}

	.edu__extra {
		display: grid;
		gap: var(--space-8);
	}

	dt {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--text-muted);
		margin-bottom: var(--space-2);
	}

	dd {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-lg);
		line-height: 1.5;
	}

	@media (width < 900px) {
		.edu {
			grid-template-columns: 1fr;
			gap: var(--space-12);
		}

		.edu__extra {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (width < 560px) {
		.edu__item {
			grid-template-columns: 1fr;
			gap: var(--space-2);
		}

		.edu__extra {
			grid-template-columns: 1fr;
		}
	}
</style>
